        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Dhl Gantt Chart</name>
    <description>Multi-source DHTMLX Gantt chart with dimensional filtering and Mendix datasource integration</description>
    <icon>
        
    </icon>
    <properties>
        <!-- Group 1: General -->
        <propertyGroup caption="General">
            <property key="viewMode" type="enumeration" defaultValue="project">
                <caption>View mode</caption>
                <description>Project schedule, resource timeline, or hybrid view</description>
                <enumerationValues>
                    <enumerationValue key="project">Project</enumerationValue>
                    <enumerationValue key="resourceTimeline">Resource timeline</enumerationValue>
                    <enumerationValue key="hybrid">Hybrid</enumerationValue>
                </enumerationValues>
            </property>
            <property key="readOnly" type="boolean" defaultValue="false">
                <caption>Read only</caption>
                <description>Disable all chart editing</description>
            </property>
            <property key="useMockData" type="boolean" defaultValue="false">
                <caption>Use mock data</caption>
                <description>Load sample data for development without Mendix datasources</description>
            </property>
            <property key="timeZoneMode" type="enumeration" defaultValue="browserLocal">
                <caption>Time zone mode</caption>
                <description>Time zone mode</description>
                <enumerationValues>
                    <enumerationValue key="utc">UTC</enumerationValue>
                    <enumerationValue key="browserLocal">Browser local</enumerationValue>
                    <enumerationValue key="fixed">Fixed</enumerationValue>
                </enumerationValues>
            </property>
            <property key="fixedTimeZone" type="string" required="false">
                <caption>Fixed time zone</caption>
                <description>IANA time zone when mode is fixed</description>
            </property>
            <property key="dateUnit" type="enumeration" defaultValue="day">
                <caption>Date unit</caption>
                <description>Date unit</description>
                <enumerationValues>
                    <enumerationValue key="minute">Minute</enumerationValue>
                    <enumerationValue key="hour">Hour</enumerationValue>
                    <enumerationValue key="day">Day</enumerationValue>
                </enumerationValues>
            </property>
            <property key="emptyMessage" type="string" required="false" defaultValue="No schedule data">
                <caption>Empty message</caption>
                <description>Empty message</description>
            </property>
            <property key="showTrialNotice" type="boolean" defaultValue="true">
                <caption>Show trial notice</caption>
                <description>Show trial notice</description>
            </property>
        </propertyGroup>

        <!-- Group 2: Multiple Dimensions -->
        <propertyGroup caption="Multiple Dimensions">
            <property key="dimensionConfig" type="object" isList="true" required="false">
                <caption>Dimension config</caption>
                <description>Configure dimension axes for filtering and grouping</description>
                <properties>
                    <propertyGroup caption="Dimension">
                        <property key="dimensionKey" type="enumeration" defaultValue="site">
                            <caption>Key</caption>
                            <description>Key</description>
                            <enumerationValues>
                                <enumerationValue key="site">Site</enumerationValue>
                                <enumerationValue key="sourceSystem">Source system</enumerationValue>
                                <enumerationValue key="department">Department</enumerationValue>
                                <enumerationValue key="status">Status</enumerationValue>
                                <enumerationValue key="project">Project</enumerationValue>
                                <enumerationValue key="resource">Resource</enumerationValue>
                            </enumerationValues>
                        </property>
                        <property key="dimensionEnabled" type="boolean" defaultValue="true">
                            <caption>Enabled</caption>
                            <description>Enabled</description>
                        </property>
                        <property key="dimensionGroupBy" type="boolean" defaultValue="false">
                            <caption>Group by</caption>
                            <description>Group by</description>
                        </property>
                        <property key="dimensionShowInGrid" type="boolean" defaultValue="true">
                            <caption>Show in grid</caption>
                            <description>Show in grid</description>
                        </property>
                        <property key="dimensionShowInFilterBar" type="boolean" defaultValue="true">
                            <caption>Show in filter bar</caption>
                            <description>Show in filter bar</description>
                        </property>
                        <property key="dimensionLabel" type="string" required="false">
                            <caption>Label</caption>
                            <description>Label</description>
                        </property>
                    </propertyGroup>
                </properties>
            </property>
            <property key="primaryGroupDimension" type="enumeration" defaultValue="none">
                <caption>Primary group dimension</caption>
                <description>Primary group dimension</description>
                <enumerationValues>
                    <enumerationValue key="none">None</enumerationValue>
                    <enumerationValue key="site">Site</enumerationValue>
                    <enumerationValue key="project">Project</enumerationValue>
                    <enumerationValue key="sourceSystem">Source system</enumerationValue>
                    <enumerationValue key="department">Department</enumerationValue>
                </enumerationValues>
            </property>
            <property key="crossFilterMode" type="enumeration" defaultValue="and">
                <caption>Cross filter mode</caption>
                <description>Cross filter mode</description>
                <enumerationValues>
                    <enumerationValue key="and">AND</enumerationValue>
                    <enumerationValue key="or">OR</enumerationValue>
                </enumerationValues>
            </property>
            <property key="filterMode" type="enumeration" defaultValue="client">
                <caption>Filter mode</caption>
                <description>Filter mode</description>
                <enumerationValues>
                    <enumerationValue key="client">Client</enumerationValue>
                    <enumerationValue key="server">Server</enumerationValue>
                </enumerationValues>
            </property>
            <property key="showDimensionFilterBar" type="boolean" defaultValue="true">
                <caption>Show dimension filter bar</caption>
                <description>Show dimension filter bar</description>
            </property>
            <property key="onDimensionFilterChanged" type="action" required="false">
                <caption>On dimension filter changed</caption>
                <description>On dimension filter changed</description>
            </property>
        </propertyGroup>

